{
  "appId": "br.com.lsautotruckrastreios.app",
  "appName": "LS Autotruck",
  "webDir": "www",
  "server": {
    "url": "https://plataforma.lsautotruckrastreios.com.br",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0F1E45"
  }
}
