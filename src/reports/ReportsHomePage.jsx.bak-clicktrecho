const ReportsHomePage = () => {
  const { classes, cx } = useStyles();
  const navigate = useNavigate();
  const devices = useSelector((state) => state.devices.items);
  const selectedDeviceId = useSelector((state) => state.devices.selectedId);
  const deviceList = useMemo(() => Object.values(devices), [devices]);

  const [deviceId, setDeviceId] = useState(
    selectedDeviceId || (deviceList[0] && deviceList[0].id) || '',
  );
  const [typeIdx, setTypeIdx] = useState(0);
  const [period, setPeriod] = useState('today');
  const [dtFrom, setDtFrom] = useState(dayjs().subtract(6, 'day').format('YYYY-MM-DD'));
  const [dtTo, setDtTo] = useState(dayjs().format('YYYY-MM-DD'));
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const mapBoxRef = useRef(null);
  const [chartMetric, setChartMetric] = useState('speed');

  useEffect(() => {
    const resize = () => {
      if (map && map.resize) {
        map.resize();
      }
    };
    const t = setTimeout(resize, 350);
    let ro;
    if (mapBoxRef.current && typeof ResizeObserver !== 'undefined') {
      ro = new ResizeObserver(resize);
      ro.observe(mapBoxRef.current);
    }
    return () => {
      clearTimeout(t);
      if (ro) ro.disconnect();
    };
  }, [result]);

  const periodLabel =
    period === 'custom'
      ? `${dayjs(dtFrom).format('DD/MM')} a ${dayjs(dtTo).format('DD/MM')}`
      : PERIODS.find((x) => x[0] === period)[1];
  const deviceName = (devices[deviceId] && devices[deviceId].name) || '';

  const dateRange = () => {
    if (period === 'custom') {
      return [dayjs(dtFrom).startOf('day'), dayjs(dtTo).endOf('day')];
    }
    return range(period);
  };

  const handleGo = async () => {
    const type = TYPES[typeIdx];
    const [from, to] = dateRange();
    const params = new URLSearchParams();
    if (deviceId) params.append('deviceId', String(deviceId));
    params.set('from', from.toISOString());
    params.set('to', to.toISOString());
    if (type.fetch === 'events') {
      (type.types ? type.types.split(',') : ['allEvents']).forEach((tp) =>
        params.append('type', tp),
      );
    }
    setLoading(true);
    setResult(null);
    try {
      if (type.render === 'map') {
        const [combResp, tripsResp] = await Promise.all([
          fetch(`/api/reports/combined?${params.toString()}`, {
            headers: { Accept: 'application/json' },
          }),
          fetch(`/api/reports/trips?${params.toString()}`, {
            headers: { Accept: 'application/json' },
          }),
        ]);
        const combined = combResp.ok ? await combResp.json() : [];
        const trips = tripsResp.ok ? await tripsResp.json() : [];
        setResult({
          type,
          data: Array.isArray(trips) ? trips : [],
          combined: Array.isArray(combined) ? combined : [],
        });
        setLoading(false);
        return;
      }
      if (type.render === 'chart') {
        const rr = await fetch(`/api/positions?${params.toString()}`, {
          headers: { Accept: 'application/json' },
        });
        const positions = rr.ok ? await rr.json() : [];
        setResult({ type, data: Array.isArray(positions) ? positions : [] });
        setLoading(false);
        return;
      }
      const resp = await fetch(`/api/reports/${type.fetch}?${params.toString()}`, {
        headers: { Accept: 'application/json' },
      });
      const data = resp.ok ? await resp.json() : [];
      let summary = [];
      if (type.render === 'summary') {
        const sp = new URLSearchParams();
        if (deviceId) sp.append('deviceId', String(deviceId));
        sp.set('from', from.toISOString());
        sp.set('to', to.toISOString());
        const sr = await fetch(`/api/reports/summary?${sp.toString()}`, {
          headers: { Accept: 'application/json' },
        });
        summary = sr.ok ? await sr.json() : [];
      }
      setResult({
        type,
        data: Array.isArray(data) ? data : [],
        summary: Array.isArray(summary) ? summary : [],
      });
    } catch {
      setResult({ type, data: [], summary: [] });
    }
    setLoading(false);
  };

  const openFull = (type) => {
    const [from, to] = dateRange();
    const params = new URLSearchParams();
    if (deviceId) params.append('deviceId', String(deviceId));
    params.set('from', from.toISOString());
    params.set('to', to.toISOString());
    navigate(`/reports/${type.open.route}?${params.toString()}`);
  };

  const shareText = () => {
    const { type, data } = result;
    const lines = [`${type.label} - ${deviceName}`, periodLabel, ''];
    if (type.render === 'summary' || type.render === 'speed') {
      const totalDist = data.reduce((a, t) => a + (t.distance || 0), 0);
      const movingMs = data.reduce((a, t) => a + (t.duration || 0), 0);
      const maxSp = data.reduce((a, t) => Math.max(a, t.maxSpeed || 0), 0);
      const avgKmh = movingMs > 0 ? Math.round(totalDist / 1000 / (movingMs / 3600000)) : 0;
      lines.push(`Distancia: ${km(totalDist)} km`);
      lines.push(`Velocidade maxima: ${kmh(maxSp)} km/h`);
      lines.push(`Velocidade media: ${avgKmh} km/h`);
      lines.push(`Tempo em movimento: ${dur(movingMs)}`);
      if (type.render === 'summary') {
        const engineMs =
          (result.summary && result.summary[0] && result.summary[0].engineHours) || 0;
        lines.push(`Ignicao ligada: ${dur(engineMs)}`);
      }
    } else if (type.render === 'trips') {
      lines.push(`${data.length} viagem(ns):`);
      data
        .slice(0, 30)
        .forEach((t) =>
          lines.push(`- ${hm(t.startTime)} a ${hm(t.endTime)}: ${km(t.distance)} km`),
        );
    } else if (type.render === 'stops') {
      lines.push(`${data.length} parada(s):`);
      data
        .slice(0, 30)
        .forEach((t) =>
          lines.push(
            `- ${dm(t.startTime)}: ${dur(t.duration)}${t.address ? ` (${t.address})` : ''}`,
          ),
        );
    } else {
      lines.push(`${data.length} alerta(s):`);
      data.slice(0, 30).forEach((e) => lines.push(`- ${dm(e.eventTime)}: ${ev(e.type)[0]}`));
    }
    lines.push('', 'LS Autotruck Rastreios');
    return lines.join('\n');
  };

  const shareReport = () => {
    const text = shareText();
    if (navigator.share) {
      navigator.share({ title: `${result.type.label} - ${deviceName}`, text }).catch(() => {});
    } else {
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    }
  };

  const renderResult = () => {
    const { type, data } = result;
    if (type.render === 'chart') {
      const positions = data;
      if (positions.length < 2) {
        return <div className={classes.empty}>Sem dados nesse período.</div>;
      }
      const step = Math.max(1, Math.ceil(positions.length / 150));
      const chartData = positions
        .filter((_, i) => i % step === 0)
        .map((pp) => ({
          t: hm(pp.fixTime),
          speed: Math.round((pp.speed || 0) * 1.852),
          alt: Math.round(pp.altitude || 0),
          ignition: pp.attributes && pp.attributes.ignition ? 1 : 0,
          power: (pp.attributes && pp.attributes.power) || 0,
        }));
      const isSpeed = chartMetric === 'speed';
      const isAltitude = chartMetric === 'altitude';
      const isIgnition = chartMetric === 'ignition';
      const dataKey = isSpeed ? 'speed' : isAltitude ? 'alt' : isIgnition ? 'ignition' : 'power';
      const unit = isSpeed ? ' km/h' : isAltitude ? ' m' : isIgnition ? '' : ' V';
      const metricLabel = isSpeed
        ? 'Velocidade'
        : isAltitude
          ? 'Altitude'
          : isIgnition
            ? 'Ignição'
            : 'Voltagem';
      const maxV = positions.reduce((a, pp) => {
        if (isSpeed) return Math.max(a, Math.round((pp.speed || 0) * 1.852));
        if (isAltitude) return Math.max(a, Math.round(pp.altitude || 0));
        if (isIgnition) return a;
        return Math.max(a, (pp.attributes && pp.attributes.power) || 0);
      }, 0);
      const onPct = chartData.length
        ? Math.round((chartData.filter((d) => d.ignition === 1).length / chartData.length) * 100)
        : 0;
      return (
        <>
          <div className={classes.toggle}>
            <div
              className={cx(classes.tg, isSpeed && classes.tgOn)}
              onClick={() => setChartMetric('speed')}
            >
              Velocidade
            </div>
            <div
              className={cx(classes.tg, isAltitude && classes.tgOn)}
              onClick={() => setChartMetric('altitude')}
            >
              Altitude
            </div>
            <div
              className={cx(classes.tg, isIgnition && classes.tgOn)}
              onClick={() => setChartMetric('ignition')}
            >
              Ignição
            </div>
            <div
              className={cx(classes.tg, chartMetric === 'power' && classes.tgOn)}
              onClick={() => setChartMetric('power')}
            >
              Voltagem
            </div>
          </div>
          <div className={classes.chartCard}>
            <ResponsiveContainer width="100%" height={220}>
              <AreaChart data={chartData} margin={{ top: 10, right: 8, left: -12, bottom: 0 }}>
                <defs>
                  <linearGradient id="lsGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stopColor="#1C7ED6" stopOpacity={0.35} />
                    <stop offset="100%" stopColor="#1C7ED6" stopOpacity={0} />
                  </linearGradient>
                </defs>
                <CartesianGrid strokeDasharray="3 3" stroke="#eef1f6" vertical={false} />
                <XAxis
                  dataKey="t"
                  tick={{ fontSize: 10, fill: '#90a4ae' }}
                  tickLine={false}
                  axisLine={false}
                  minTickGap={44}
                />
                <YAxis
                  tick={{ fontSize: 10, fill: '#90a4ae' }}
                  tickLine={false}
                  axisLine={false}
                  width={34}
                  domain={isIgnition ? [0, 1] : ['auto', 'auto']}
                  ticks={isIgnition ? [0, 1] : undefined}
                  tickFormatter={isIgnition ? (v) => (v ? 'Ligado' : 'Desligado') : undefined}
                />
                <Tooltip
                  formatter={(v) => [
                    isIgnition ? (v ? 'Ligado' : 'Desligado') : `${v}${unit}`,
                    metricLabel,
                  ]}
                  labelStyle={{ color: '#0d2a5c', fontWeight: 600 }}
                  contentStyle={{ borderRadius: 10, border: '1px solid #e3e8ef', fontSize: 12 }}
                />
                <Area
                  type={isIgnition ? 'stepAfter' : 'monotone'}
                  dataKey={dataKey}
                  stroke="#1C7ED6"
                  strokeWidth={2.5}
                  fill="url(#lsGrad)"
                />
              </AreaChart>
            </ResponsiveContainer>
          </div>
          <div className={classes.stats}>
            <div className={classes.stat}>
              <div className={classes.statLab}>
                {isSpeed
                  ? 'Velocidade máxima'
                  : isAltitude
                    ? 'Altitude máxima'
                    : isIgnition
                      ? 'Tempo ligado'
                      : 'Voltagem máxima'}
              </div>
              <div className={classes.statVal}>{isIgnition ? `${onPct}%` : `${maxV}${unit}`}</div>
            </div>
            <div className={classes.stat}>
              <div className={classes.statLab}>Pontos no período</div>
              <div className={classes.statVal}>{positions.length}</div>
            </div>
          </div>
        </>
      );
    }
    if (type.render === 'map') {
      const route = (result.combined && result.combined[0] && result.combined[0].route) || [];
      const trips = data;
      const totalDist = trips.reduce((a, t) => a + (t.distance || 0), 0);
      const movingMs = trips.reduce((a, t) => a + (t.duration || 0), 0);
      const maxSp = trips.reduce((a, t) => Math.max(a, t.maxSpeed || 0), 0);
      const avgKmh = movingMs > 0 ? Math.round(totalDist / 1000 / (movingMs / 3600000)) : 0;
      return (
        <>
          {route.length > 1 ? (
            <div className={classes.mapBox} ref={mapBoxRef}>
              <MapViewCore>
                <MapRouteCoordinates name={deviceName} coordinates={route} deviceId={deviceId} />
              </MapViewCore>
              <MapCamera coordinates={route} />
            </div>
          ) : (
            <div className={classes.empty}>Sem percurso nesse período.</div>
          )}
          {trips.length > 0 && (
            <div className={classes.stats}>
              <div className={classes.stat}>
                <div className={classes.statLab}>Distância</div>
                <div className={classes.statVal}>{`${km(totalDist)} km`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Velocidade máxima</div>
                <div className={classes.statVal}>{`${kmh(maxSp)} km/h`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Velocidade média</div>
                <div className={classes.statVal}>{`${avgKmh} km/h`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Tempo em movimento</div>
                <div className={classes.statVal}>{dur(movingMs)}</div>
              </div>
            </div>
          )}
          {trips.length > 0 && (
            <>
              <div className={classes.lab2}>{`Trechos do percurso (${trips.length})`}</div>
              {trips.map((t, i) => (
                <div className={classes.item} key={i}>
                  <div className={classes.itemTop}>
                    <span>{`Trecho ${i + 1}`}</span>
                    <span>{`${km(t.distance)} km`}</span>
                  </div>
                  <div className={classes.leg}>
                    <span className={classes.dotA} />
                    {`Saída ${hm(t.startTime)}${t.startAddress ? ` · ${t.startAddress}` : ''}`}
                  </div>
                  <div className={classes.leg}>
                    <span className={classes.dotB} />
                    {`Chegada ${hm(t.endTime)}${t.endAddress ? ` · ${t.endAddress}` : ''}`}
                  </div>
                  <div
                    className={classes.itemSub}
                  >{`${dur(t.duration)} · máx ${kmh(t.maxSpeed)} km/h`}</div>
                </div>
              ))}
            </>
          )}
        </>
      );
    }
    if (type.render === 'speed') {
      const trips = [...data].sort((a, b) => (b.maxSpeed || 0) - (a.maxSpeed || 0));
      const maxSp = trips.reduce((a, t) => Math.max(a, t.maxSpeed || 0), 0);
      const totalDist = data.reduce((a, t) => a + (t.distance || 0), 0);
      const movingMs = data.reduce((a, t) => a + (t.duration || 0), 0);
      const avgKmh = movingMs > 0 ? Math.round(totalDist / 1000 / (movingMs / 3600000)) : 0;
      if (!trips.length) return <div className={classes.empty}>Sem movimento nesse período.</div>;
      return (
        <>
          <div className={classes.stats}>
            <div className={classes.stat}>
              <div className={classes.statLab}>Velocidade máxima</div>
              <div className={classes.statVal}>{`${kmh(maxSp)} km/h`}</div>
            </div>
            <div className={classes.stat}>
              <div className={classes.statLab}>Velocidade média</div>
              <div className={classes.statVal}>{`${avgKmh} km/h`}</div>
            </div>
          </div>
          <div className={classes.lab2}>Trechos mais rápidos</div>
          {trips.map((t, i) => (
            <div className={classes.item} key={i}>
              <div className={classes.itemTop}>
                <span>{`${hm(t.startTime)} -> ${hm(t.endTime)}`}</span>
                <span>{`${kmh(t.maxSpeed)} km/h`}</span>
              </div>
              <div className={classes.bar}>
                <div
                  className={classes.barFill}
                  style={{
                    width: `${maxSp > 0 ? Math.round(((t.maxSpeed || 0) / maxSp) * 100) : 0}%`,
                  }}
                />
              </div>
            </div>
          ))}
        </>
      );
    }
    if (type.render === 'summary') {
      const trips = data;
      const totalDist = trips.reduce((a, t) => a + (t.distance || 0), 0);
      const movingMs = trips.reduce((a, t) => a + (t.duration || 0), 0);
      const maxSp = trips.reduce((a, t) => Math.max(a, t.maxSpeed || 0), 0);
      const avgKmh = movingMs > 0 ? Math.round(totalDist / 1000 / (movingMs / 3600000)) : 0;
      const engineMs = (result.summary && result.summary[0] && result.summary[0].engineHours) || 0;
      const hasData = trips.length > 0 || engineMs > 0;
      return (
        <>
          {!hasData && <div className={classes.empty}>Sem dados nesse período.</div>}
          {hasData && (
            <div className={classes.stats}>
              <div className={classes.stat}>
                <div className={classes.statLab}>Distância</div>
                <div className={classes.statVal}>{`${km(totalDist)} km`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Velocidade máxima</div>
                <div className={classes.statVal}>{`${kmh(maxSp)} km/h`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Velocidade média</div>
                <div className={classes.statVal}>{`${avgKmh} km/h`}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Tempo em movimento</div>
                <div className={classes.statVal}>{dur(movingMs)}</div>
              </div>
              <div className={classes.stat}>
                <div className={classes.statLab}>Ignição ligada</div>
                <div className={classes.statVal}>{dur(engineMs)}</div>
              </div>
            </div>
          )}
          {type.open && (
            <button type="button" className={classes.openBtn} onClick={() => openFull(type)}>
              <MapIcon sx={{ fontSize: 19 }} />
              {type.open.label}
            </button>
          )}
        </>
      );
    }
    if (!data.length) return <div className={classes.empty}>Nenhum dado nesse período.</div>;
    if (type.render === 'trips') {
      return data.map((t, i) => (
        <div className={classes.item} key={i}>
          <div className={classes.itemTop}>
            <span>{`${hm(t.startTime)} -> ${hm(t.endTime)}`}</span>
            <span>{`${km(t.distance)} km`}</span>
          </div>
          <div
            className={classes.itemSub}
          >{`${dur(t.duration)} - máx ${kmh(t.maxSpeed)} km/h`}</div>
          {(t.startAddress || t.endAddress) && (
            <div
              className={classes.itemSub}
            >{`${t.startAddress || '...'} -> ${t.endAddress || '...'}`}</div>
          )}
        </div>
      ));
    }
    if (type.render === 'stops') {
      return data.map((t, i) => (
        <div className={classes.item} key={i}>
          <div className={classes.itemTop}>
            <span>{t.address || 'Parada'}</span>
            <span>{dur(t.duration)}</span>
          </div>
          <div className={classes.itemSub}>{dm(t.startTime)}</div>
        </div>
      ));
    }
    return data.map((e, i) => {
      const [lab, color] = ev(e.type);
      return (
        <div className={classes.item} key={i}>
          <div className={classes.itemTop}>
            <span style={{ color }}>{lab}</span>
            <span style={{ fontWeight: 400, fontSize: 12, color: '#90a4ae' }}>
              {dm(e.eventTime)}
            </span>
          </div>
        </div>
      );
    });
  };

  if (loading) {
    return (
      <div className={classes.root}>
        <div className={classes.loading}>
          <CircularProgress />
          <div>Gerando relatório...</div>
        </div>
      </div>
    );
  }

  if (result) {
    return (
      <div className={classes.root}>
        <div className={classes.resultHead}>
          <div className={classes.back} onClick={() => setResult(null)}>
            <ArrowBackIcon sx={{ fontSize: 20 }} /> Novo relatório
          </div>
          <button type="button" className={classes.shareBtn} onClick={shareReport}>
            <ShareIcon sx={{ fontSize: 17 }} /> Compartilhar
          </button>
        </div>
        <div className={classes.title}>{result.type.label}</div>
        <div className={classes.sub}>{`${deviceName} - ${periodLabel}`}</div>
        {renderResult()}
      </div>
    );
  }

  return (
    <div className={classes.root}>
      <div className={classes.title}>Relatórios</div>

      <div className={classes.lab}>Veículo</div>
      <FormControl fullWidth size="small">
        <Select
          className={classes.device}
          value={deviceId}
          onChange={(e) => setDeviceId(e.target.value)}
          displayEmpty
        >
          {deviceList.length === 0 && <MenuItem value="">Nenhum veículo</MenuItem>}
          {deviceList.map((d) => (
            <MenuItem key={d.id} value={d.id}>
              {d.name}
            </MenuItem>
          ))}
        </Select>
      </FormControl>

      <div className={classes.lab}>O que você quer ver?</div>
      <div className={classes.grid}>
        {TYPES.map((it, i) => {
          const { Icon } = it;
          return (
            <div
              key={it.label}
              className={cx(classes.card, i === typeIdx && classes.cardOn)}
              onClick={() => setTypeIdx(i)}
            >
              <Icon sx={{ color: '#1C7ED6', fontSize: 22 }} />
              <div className={classes.cardName}>{it.label}</div>
              <div className={classes.cardDesc}>{it.desc}</div>
            </div>
          );
        })}
      </div>

      <div className={classes.lab}>Período</div>
      <div className={classes.chips}>
        {PERIODS.map(([key, label]) => (
          <div
            key={key}
            className={cx(classes.chip, period === key && classes.chipOn)}
            onClick={() => setPeriod(key)}
          >
            {key === 'custom' && <CalendarMonthIcon sx={{ fontSize: 15 }} />}
            {label}
          </div>
        ))}
      </div>
      {period === 'custom' && (
        <div className={classes.dateRow}>
          <TextField
            type="date"
            label="De"
            size="small"
            fullWidth
            value={dtFrom}
            onChange={(e) => setDtFrom(e.target.value)}
            InputLabelProps={{ shrink: true }}
            sx={{ background: '#fff', borderRadius: 1 }}
          />
          <TextField
            type="date"
            label="Até"
            size="small"
            fullWidth
            value={dtTo}
            onChange={(e) => setDtTo(e.target.value)}
            InputLabelProps={{ shrink: true }}
            sx={{ background: '#fff', borderRadius: 1 }}
          />
        </div>
      )}

      <button type="button" className={classes.go} onClick={handleGo} disabled={!deviceId}>
        <VisibilityIcon sx={{ fontSize: 20 }} /> Ver relatório
      </button>
    </div>
  );
};

export default ReportsHomePage;
